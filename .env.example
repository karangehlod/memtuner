# ============================================================================
# Agentic Memory Benchmark — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values.
# Variables with a default shown can be omitted to use the default.
# The benchmark runs fully offline with BM25 — no API keys required.
#
# Variable reference mirrors benchmark/config/loader.py exactly.
# ============================================================================

# ============================================================================
# LOCAL SENTENCE-TRANSFORMER EMBEDDINGS
# ============================================================================
# Used when retrieval_strategy = "embeddings" (no API required).
# Model is downloaded once to ~/.cache/sentence_transformers (or CACHE_DIR).

# Primary embedding model
# Default: all-MiniLM-L6-v2 (90 MB, fast)
# Options: BAAI/bge-base-en-v1.5 (450 MB, stronger), BAAI/bge-large-en-v1.5 (1.3 GB)
BENCHMARK_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Comma-separated list of models to sweep in "benchmark analyze" comparisons
BENCHMARK_EMBEDDING_MODELS=all-MiniLM-L6-v2,BAAI/bge-base-en-v1.5

# Cache directory for sentence-transformers downloads (default: ~/.cache/sentence_transformers)
# BENCHMARK_EMBED_CACHE_DIR=.cache/sentence_transformers

# Routing mode: fixed_local (always use local model) or adaptive (use API if model is too large)
# Default: fixed_local
BENCHMARK_EMBEDDING_ROUTING_MODE=fixed_local

# Size threshold (MB) — models above this are routed to API in adaptive mode
# Default: 100
BENCHMARK_LOCAL_MODEL_SIZE_THRESHOLD_MB=100

# Preferred API providers for adaptive routing (comma-separated, ordered by preference)
# Default: hf_inference,ollama
BENCHMARK_EMBEDDING_API_PROVIDER_ORDER=hf_inference,ollama

# ============================================================================
# HUGGING FACE INFERENCE API EMBEDDINGS
# ============================================================================
# Used when retrieval_strategy = "hf_inference_embeddings".

# HF API token (required for authenticated inference endpoints)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
# BENCHMARK_HF_API_TOKEN=hf_your_token_here  # alternative name

# HF router base URL (default: https://router.huggingface.co)
BENCHMARK_HF_API_BASE_URL=https://router.huggingface.co

# HF inference model for strategy runs
BENCHMARK_HF_INFERENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Comma-separated models for "benchmark analyze" comparison
BENCHMARK_HF_INFERENCE_MODELS=sentence-transformers/all-MiniLM-L6-v2,BAAI/bge-base-en-v1.5

# Explicit endpoint URL (overrides base_url + model_name routing, optional)
# BENCHMARK_HF_INFERENCE_URL=https://your-inference-endpoint.hf.space

# Request timeout (seconds), default: 60.0
BENCHMARK_HF_TIMEOUT=60.0

# ============================================================================
# OLLAMA EMBEDDINGS
# ============================================================================
# Used when retrieval_strategy = "ollama_embeddings".
# Requires Ollama running with the target model pulled.

# Ollama server URL (OpenAI-compatible endpoint)
BENCHMARK_OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama API key (not required for local Ollama)
BENCHMARK_OLLAMA_API_KEY=not-needed

# Request timeout (seconds), default: 60.0
BENCHMARK_OLLAMA_TIMEOUT=120

# Primary Ollama embedding model
# Options: qwen3-embedding:0.6b, qwen3-embedding:4b, bge-m3:latest, embeddinggemma:latest
BENCHMARK_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Comma-separated Ollama models for "benchmark analyze" comparison
BENCHMARK_OLLAMA_EMBEDDING_MODELS=qwen3-embedding:0.6b,bge-m3:latest

# ============================================================================
# RERANKER CONFIGURATION
# ============================================================================
# Used when retrieval_strategy = "llm_rerank" or benchmark analyze runs reranker phase.

# Reranker strategy: local_overlap (n-gram Jaccard, no model) or adaptive_api
# Default: local_overlap
BENCHMARK_RERANKER_STRATEGY=local_overlap

# Reranker model (used when strategy = adaptive_api)
# Options: cross-encoder/ms-marco-MiniLM-L6-v2, BAAI/bge-reranker-base, BAAI/bge-reranker-v2-m3
# BENCHMARK_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Reranker model cache directory
# BENCHMARK_RERANKER_CACHE_DIR=.cache/rerankers

# Models above this size (MB) are routed to API in adaptive mode
# Default: 100
BENCHMARK_RERANKER_LOCAL_SIZE_THRESHOLD_MB=100

# Preferred API providers for reranker (comma-separated)
# Default: hf_inference,ollama
BENCHMARK_RERANKER_API_PROVIDER_ORDER=hf_inference,ollama

# ============================================================================
# BENCHMARK ANALYZE — SKIP FLAGS
# ============================================================================
# Set to "true" to skip specific comparison phases in "benchmark analyze".
# Useful when a provider is not configured or you only want a subset.

# Skip local sentence-transformer model comparison
# BENCHMARK_ANALYZE_SKIP_LOCAL_EMBEDDING_COMPARISON=false

# Skip HuggingFace Inference API comparison (skip if HF_TOKEN not set)
BENCHMARK_ANALYZE_SKIP_HF_INFERENCE_COMPARISON=false

# Skip Ollama embedding model comparison (skip if Ollama not running)
# BENCHMARK_ANALYZE_SKIP_OLLAMA_EMBEDDING_COMPARISON=false

# Skip reranker comparison
# BENCHMARK_ANALYZE_SKIP_RERANKER_COMPARISON=false

# Skip memory type comparison
# BENCHMARK_ANALYZE_SKIP_MEMORY_TYPE_COMPARISON=false

# Skip decay parameter sweep
# BENCHMARK_ANALYZE_SKIP_DECAY_SWEEP=false

# Skip plot generation (if matplotlib not installed)
# BENCHMARK_ANALYZE_SKIP_PLOTS=false

# Skip isolation test
# BENCHMARK_ANALYZE_SKIP_ISOLATION_TEST=false

# ============================================================================
# BENCHMARK ANALYZE — STRATEGY / MEMORY ALLOWLISTS
# ============================================================================
# Comma-separated lists. Leave unset to include all.

# Strategies to include in "benchmark analyze" runs
# BENCHMARK_ANALYZE_STRATEGIES=bm25,embeddings,hybrid,ollama_embeddings,llm_rerank

# Memory types to include
# BENCHMARK_ANALYZE_MEMORY_TYPES=episodic,semantic,preference,entity

# ============================================================================
# LLM ANSWERING / JUDGE CONFIGURATION (optional)
# ============================================================================
# Required only when answering.enabled = true in config, or with --with-llm-judge.

# Ollama LLM (free, local)
BENCHMARK_LLM_BASE_URL=http://localhost:11434/v1
BENCHMARK_LLM_MODEL=nemotron-3-nano:4b

# OpenAI (cloud)
# OPENAI_API_KEY=sk-your-key-here
# BENCHMARK_LLM_BASE_URL=https://api.openai.com/v1
# BENCHMARK_LLM_MODEL=gpt-4o-mini

# Judge model (used for LLM-as-judge evaluation, falls back to LLM config if not set)
# BENCHMARK_JUDGE_BASE_URL=
# BENCHMARK_JUDGE_MODEL=

# ============================================================================
# DATASET AND RUN SETTINGS
# ============================================================================

# Default gold dataset path (overridden by --gold-dataset CLI flag)
BENCHMARK_DATASET=data/locomo10.json

# Default random seed
BENCHMARK_SEED=42

# Default recall K (overridden by dataset's evaluation_criteria.recall_k)
# BENCHMARK_RECALL_K=10

# ============================================================================
# AUTO-CONFIGURED BY BENCHMARK DOCTOR (benchmark doctor --apply)
# ============================================================================
# These values are set automatically by running: benchmark doctor --apply
# They reflect what fits on your specific hardware.
# You can also set them manually to override hardware detection.

# Number of parallel workers (default: cpu_count // 2)
# BENCHMARK_WORKERS=5

# Space-separated list of embedding models to skip (too large for VRAM)
# BENCHMARK_SKIP_MODELS=Qwen/Qwen3-Embedding-4B
